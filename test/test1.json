{
  "event": {
    "body": "{\"text\":\"find the best team in season 2026\"}",
    "headers": {
      "Content-Type": "application/json"
    },
    "httpMethod": "POST",
    "path": "/search"
  },
  "result": {
    "entity": "team",
    "filter": {
      "and": [
        {
          "field": "season_id",
          "op": "eq",
          "value": 203
        }
      ]
    },
    "orderBy": {
      "field": "teams.best_skill_score",
      "direction": "desc"
    },
    "selectTop": 1
  }
}