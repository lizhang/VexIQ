{
    "event": {
        "body": "{\"text\":\"find top 10 team in LA for workshop in 2025\"}",
        "headers": {
            "Content-Type": "application/json"
        },
        "httpMethod": "POST",
        "path": "/search"
    },
    "result": {
        "entity": "team",
        "filter": {
          "and": [
            {
              "field": "teams.city",
              "op": "eq",
              "value": "Los Angeles"
            },
            {
              "field": "teams.country",
              "op": "eq",
              "value": "United States"
            },
            {
              "field": "program_id",
              "op": "eq",
              "value": 37
            },
            {
              "field": "season_id",
              "op": "eq",
              "value": 196
            }
          ]
        },
        "orderBy": {
          "field": "rankings.rank",
          "direction": "asc"
        },
        "selectTop": 10
      }
}